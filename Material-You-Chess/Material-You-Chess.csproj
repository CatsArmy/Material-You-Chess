<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <SupportedOSPlatformVersion>32.0</SupportedOSPlatformVersion>
    <TargetFramework>net9.0-android35.0</TargetFramework>
    <RootNamespace>Chess</RootNamespace>
    <OutputType>Exe</OutputType>
    <ApplicationId>com.catsarmy.chess</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <RuntimeIdentifiers>android-arm;android-arm64;android-x86;android-x64</RuntimeIdentifiers>
    <EnableNetNativeDeveloperExperienceMode>True</EnableNetNativeDeveloperExperienceMode>
    <DebuggerSupport>True</DebuggerSupport>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>
    <AnalysisLevel>preview</AnalysisLevel>
    <WarningLevel>9999</WarningLevel>
  </PropertyGroup>

  <PropertyGroup>
    <AndroidEnableProfiler>False</AndroidEnableProfiler>
    <AndroidEnableMultiDex>False</AndroidEnableMultiDex>
    <AndroidEnableProfiledAot>False</AndroidEnableProfiledAot>
    <EnableLLVM>False</EnableLLVM>
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
    <RunAOTCompilation>False</RunAOTCompilation>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">        
    <!--
      Enables trim analyzers and full trimming during Release mode.
      To learn more, see: https://learn.microsoft.com/dotnet/core/deploying/trimming/trimming-options#trimming-granularity
    -->
  <TrimMode>full</TrimMode>
  <IsAotCompatible>True</IsAotCompatible>
  <RunAOTCompilation>True</RunAOTCompilation>
  <DebugType>portable</DebugType>
  </PropertyGroup>
  
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Text.Json.Serialization.RespectNullableAnnotationsDefault" Value="true" />
    <RuntimeHostConfigurationOption Include="System.Text.Json.Serialization.RespectRequiredConstructorParametersDefault" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Graphics" Version="9.0.40" />
    <PackageReference Include="Microsoft.Maui.Essentials" Version="9.0.40" />
    <PackageReference Include="System.Text.Json" Version="9.0.2" />
    <PackageReference Include="Xamarin.Android.Glide" Version="4.16.0.11" />
    <PackageReference Include="Xamarin.Android.Glide.Annotations" Version="4.16.0.11" />
    <PackageReference Include="Xamarin.Android.Glide.DiskLruCache" Version="4.16.0.11" />
    <PackageReference Include="Xamarin.Android.Glide.GifDecoder" Version="4.16.0.11" />
    <PackageReference Include="Xamarin.Android.Glide.RecyclerViewIntegration" Version="4.16.0.11" />
    <PackageReference Include="Xamarin.AndroidX.Annotation" Version="1.9.1.2" />
    <PackageReference Include="Xamarin.AndroidX.Annotation.Jvm" Version="1.9.1.2" />
    <PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.7.0.5" />
    <PackageReference Include="Xamarin.AndroidX.Biometric" Version="1.1.0.27" />
    <PackageReference Include="Xamarin.AndroidX.Compose.Material" Version="1.7.6.1" />
    <PackageReference Include="Xamarin.AndroidX.Compose.Material.Icons.Extended" Version="1.7.6.1" />
    <PackageReference Include="Xamarin.AndroidX.Compose.Material3" Version="1.3.1.2" />
    <PackageReference Include="Xamarin.AndroidX.ConstraintLayout" Version="2.2.0.2" />
    <PackageReference Include="Xamarin.Firebase.Auth" Version="123.1.0.2" />
    <PackageReference Include="Xamarin.AndroidX.Media" Version="1.7.0.9" />
    <PackageReference Include="Xamarin.AndroidX.Compose.UI.ViewBinding" Version="1.7.6.1" />
    <PackageReference Include="Xamarin.AndroidX.DataBinding.ViewBinding" Version="8.8.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Navigation.UI" Version="2.8.5.1" />
    <PackageReference Include="Xamarin.Firebase.Storage" Version="121.0.1.2" />
    <PackageReference Include="Xamarin.Google.Android.Material" Version="1.12.0.2" />
    <PackageReference Include="Xamarin.Google.Android.Play.Core.Common" Version="2.0.4.4" />
    <PackageReference Include="Xamarin.Google.Android.Play.Integrity" Version="1.4.0.3" />
    <PackageReference Include="Xamarin.Google.Android.Recaptcha" Version="18.6.1.2" />
    <PackageReference Include="Xamarin.Google.ErrorProne.Annotations" Version="2.36.0.1" />
    <PackageReference Include="Xamarin.Google.Guava.ListenableFuture" Version="1.0.0.26" />
    <PackageReference Include="Xamarin.GooglePlayServices.Nearby" Version="119.3.0.4" />
  </ItemGroup>

  <!--<Import Project="$(SolutionDir)Directory.Build.props" />-->

</Project>