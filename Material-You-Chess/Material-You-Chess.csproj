<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Chess</RootNamespace>
    <TargetFramework>net9.0-android35.0</TargetFramework>
    <SupportedOSPlatformVersion>32.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>android-arm;android-arm64;android-x86;android-x64</RuntimeIdentifiers>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationId>com.catsarmy.chess</ApplicationId>
  </PropertyGroup>

  <PropertyGroup>
    <RestoreAdditionalProjectSources>$(SolutionDir)/BindingPackages</RestoreAdditionalProjectSources>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>preview</AnalysisLevel>
    <LangVersion>preview</LangVersion>
    <WarningLevel>9999</WarningLevel>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  
  <Import Project="Properties\Material-You-Chess.Build.props.user" />
  
  <ItemGroup>
    <GoogleServicesJson Include="$(GoogleServicesJsonFile)" />
    <None Include="Properties\Material-You-Chess.Build.props.user" />
    <None Include="Properties\Material-You-Chess.Build.props.user.template" />
  </ItemGroup>

  <PropertyGroup>
    <EnableLLVM>False</EnableLLVM>
    <AndroidEnableProfiler>False</AndroidEnableProfiler>
    <AndroidEnableMultiDex>False</AndroidEnableMultiDex>
    <AndroidEnableProfiledAot>False</AndroidEnableProfiledAot>
    <AndroidFragmentType>AndroidX.Fragment.App.Fragment</AndroidFragmentType>
    <JavaMaximumHeapSize>2G</JavaMaximumHeapSize>
    <!--<AndroidEnableMarshalMethods>True</AndroidEnableMarshalMethods>
    <AndroidGenerateJniMarshalMethods>True</AndroidGenerateJniMarshalMethods>
    <AndroidEnablePreloadAssemblies>True</AndroidEnablePreloadAssemblies>
    <AndroidLintEnabled>True</AndroidLintEnabled>-->
  </PropertyGroup>
  
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugSymbols>True</DebugSymbols>
    <DebugType>full</DebugType>
    <DebugType>embedded</DebugType>
    <AndroidManagedSymbols>True</AndroidManagedSymbols>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=./</PathMap>
    <Optimize>False</Optimize>
    <StripSymbols>False</StripSymbols>
    <RunAOTCompilation>False</RunAOTCompilation>
    <PublishTrimmed>False</PublishTrimmed>
    <EmbedAssembliesIntoApk>True</EmbedAssembliesIntoApk>

      <SignAssembly>True</SignAssembly>
  <AndroidUseApkSigner>true</AndroidUseApkSigner>
  <AndroidKeyStore>true</AndroidKeyStore>
  <AndroidSigningKeyStore>catsarmy.keystore</AndroidSigningKeyStore>
  <AndroidSigningKeyAlias>catsarmy</AndroidSigningKeyAlias>
  <AndroidSigningKeyPass>$(AndroidSigningPassword)</AndroidSigningKeyPass>
  <AndroidSigningStorePass>$(AndroidSigningPassword)</AndroidSigningStorePass>  
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">        
  <RunAOTCompilation>True</RunAOTCompilation>
  <IsAotCompatible>True</IsAotCompatible>
  <DebugType>portable</DebugType>
    <!--
      Enables trim analyzers and full trimming during Release mode.
      To learn more, see: https://learn.microsoft.com/dotnet/core/deploying/trimming/trimming-options#trimming-granularity
    -->
  <TrimMode>full</TrimMode>

  <SignAssembly>True</SignAssembly>
  <AndroidUseApkSigner>true</AndroidUseApkSigner>
  <AndroidKeyStore>true</AndroidKeyStore>
  <AndroidSigningKeyStore>catsarmy.keystore</AndroidSigningKeyStore>
  <AndroidSigningKeyAlias>catsarmy</AndroidSigningKeyAlias>
  <AndroidSigningKeyPass>$(AndroidSigningPassword)</AndroidSigningKeyPass>
  <AndroidSigningStorePass>$(AndroidSigningPassword)</AndroidSigningStorePass>  
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FirebaseUI" Version="1.0.0" />

    <PackageReference Include="Microsoft.Maui.Graphics" Version="9.0.50" />
    <PackageReference Include="Microsoft.Maui.Essentials" Version="9.0.50" />
    <PackageReference Include="System.Text.Json" Version="9.0.3" />

    <PackageReference Include="Xamarin.AndroidX.Annotation" Version="1.9.1.2" />
    <PackageReference Include="Xamarin.AndroidX.Annotation.Jvm" Version="1.9.1.2" />
    <PackageReference Include="Xamarin.AndroidX.Core.Animation" Version="1.0.0.5" />

    <PackageReference Include="Xamarin.Firebase.AppCheck" Version="118.0.0.4" />
    <PackageReference Include="Xamarin.Firebase.AppCheck.Debug" Version="118.0.0.4" />
    <PackageReference Include="Xamarin.Firebase.AppCheck.PlayIntegrity" Version="118.0.0.4" />
    <PackageReference Include="Xamarin.Firebase.Auth" Version="123.2.0" />
    <PackageReference Include="Xamarin.Firebase.Storage" Version="121.0.1.2" />

    <PackageReference Include="Xamarin.Android.Glide" Version="4.16.0.11" />
    <PackageReference Include="Xamarin.Android.Glide.AVIF.Integration" Version="4.16.0.11" />
    <PackageReference Include="Xamarin.Android.Glide.RecyclerViewIntegration" Version="4.16.0.11" />
    
    <PackageReference Include="Xamarin.AndroidX.Activity" Version="1.10.1" />
    <PackageReference Include="Xamarin.AndroidX.Fragment" Version="1.8.6" />

    <PackageReference Include="Xamarin.AndroidX.Browser" Version="1.8.0.8" />
    <PackageReference Include="Xamarin.AndroidX.CardView" Version="1.0.0.33" />
    <PackageReference Include="Xamarin.AndroidX.ConstraintLayout" Version="2.2.1" />
    <PackageReference Include="Xamarin.AndroidX.Legacy.Support.V4" Version="1.0.0.31" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Extensions" Version="2.2.0.31" />
    <PackageReference Include="Xamarin.Google.Android.Material" Version="1.12.0.2" />
   
    <PackageReference Include="Xamarin.GooglePlayServices.Auth" Version="121.3.0.1" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Android" Version="1.9.0.2" />
    <PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" Version="1.15.0.2" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" Version="2.8.7.2" />
    <PackageReference Include="Xamarin.GoogleAndroid.Libraries.Identity.GoogleId" Version="1.1.0.8" />
    <PackageReference Include="Xamarin.AndroidX.RecyclerView" Version="1.4.0" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime" Version="2.8.7.2" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel" Version="2.8.7.2" />

    <PackageReference Include="Xamarin.Google.Android.Recaptcha" Version="18.7.0" />
    <PackageReference Include="Xamarin.GooglePlayServices.Nearby" Version="119.3.0.4" />
  </ItemGroup>
</Project>
